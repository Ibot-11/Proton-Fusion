+#ifdef SONAME_LIBXDAMAGE
+static typeof(XDamageCreate) *pXDamageCreate;
+static typeof(XDamageDestroy) *pXDamageDestroy;
+static typeof(XDamageSubtract) *pXDamageSubtract;
+static XContext damage_context;
+static LONG damage_enabled;
+static int damage_opcode, damage_error_base;
+static pthread_once_t damage_once = PTHREAD_ONCE_INIT;
+
+static int damage_create_error( Display *display, XErrorEvent *event, void *arg )
+{
+    return event->request_code == damage_opcode && event->minor_code == X_DamageCreate &&
+           event->error_code == BadDrawable;
+}
+
+/* A drawable can disappear before queued notifications or cleanup requests
+ * arrive. Only these two invalid-Damage errors are harmless; keep all other
+ * X11 errors on the normal reporting path. No round trip is added per frame. */
+BOOL client_surface_damage_error( Display *display, XErrorEvent *event )
+{
+    if (!InterlockedCompareExchange( &damage_enabled, 0, 0 ) || event->request_code != damage_opcode ||
+        event->error_code != damage_error_base + BadDamage ||
+        (event->minor_code != X_DamageDestroy && event->minor_code != X_DamageSubtract)) return FALSE;
+    if (event->minor_code == X_DamageSubtract)
+    {
+        struct client_surface *client;
+        /* Context removal precedes object destruction under the display lock, so
+         * the pointer is live while marking it. The next normal surface
+         * update rebuilds the subscription, without waiting on every frame. */
+        XLockDisplay( display );
+        if (!XFindContext( display, event->resourceid, damage_context, (char **)&client ))
+            InterlockedExchange( &impl_from_client_surface( client )->damage_invalid, TRUE );
+        XUnlockDisplay( display );
+    }
+    TRACE_(fusion)( "ignoring retired Damage %#lx, request %u\n", event->resourceid, event->minor_code );
+    return TRUE;
+}
+
+static BOOL client_surface_damage_notify( HWND hwnd, XEvent *event )
+{
+    XDamageNotifyEvent *damage = (XDamageNotifyEvent *)event;
+    void *identity;
+    int missing;
+
+    XLockDisplay( event->xany.display );
+    missing = XFindContext( event->xany.display, damage->damage, damage_context, (char **)&identity );
+    XUnlockDisplay( event->xany.display );
+    if (missing) return TRUE;
+    /* Clear before painting: a new source update must be able to generate the
+     * next notification. Copying to the destination does not damage the source. */
+    pXDamageSubtract( event->xany.display, damage->damage, None, None );
+    XFlush( event->xany.display );
+    TRACE_(fusion)( "repaint after damage %#lx on drawable %#lx\n", damage->damage, damage->drawable );
+    client_surface_present_external( identity );
+    return TRUE;
+}
+
+static void client_surface_damage_init(void)
+{
+    typeof(XDamageQueryExtension) *query_extension;
+    const char *setting = getenv( "WINE_FUSION_CHILD_DAMAGE" );
+    int event_base, error_base;
+    void *handle;
+
+    if (setting && !strcmp( setting, "0" )) return;
+    if (!(handle = dlopen( SONAME_LIBXDAMAGE, RTLD_NOW ))) return;
+    query_extension = dlsym( handle, "XDamageQueryExtension" );
+    pXDamageCreate = dlsym( handle, "XDamageCreate" );
+    pXDamageDestroy = dlsym( handle, "XDamageDestroy" );
+    pXDamageSubtract = dlsym( handle, "XDamageSubtract" );
+    if (!query_extension || !pXDamageCreate || !pXDamageDestroy || !pXDamageSubtract ||
+        !query_extension( gdi_display, &event_base, &error_base ) ||
+        !XQueryExtension( gdi_display, DAMAGE_NAME, &damage_opcode, &event_base, &damage_error_base ))
+    {
+        dlclose( handle );
+        return;
+    }
+    damage_context = XUniqueContext();
+    X11DRV_register_event_handler( event_base + XDamageNotify, client_surface_damage_notify, "DamageNotify" );
+    InterlockedExchange( &damage_enabled, TRUE );
+    TRACE_(fusion)( "offscreen Vulkan damage repaint enabled\n" );
+}
+
+static void client_surface_damage_stop( struct x11drv_client_surface *surface )
+{
+    if (!surface->damage) return;
+    XLockDisplay( surface->damage_display );
+    XDeleteContext( surface->damage_display, surface->damage, damage_context );
+    XUnlockDisplay( surface->damage_display );
+    pXDamageDestroy( surface->damage_display, surface->damage );
+    XFlush( surface->damage_display );
+    surface->damage = None;
+    surface->damage_display = NULL;
+    InterlockedExchange( &surface->damage_invalid, FALSE );
+}
+
+static void client_surface_damage_start( HWND hwnd, struct x11drv_client_surface *surface )
+{
+    struct x11drv_win_data *data;
+
+    if (!surface->vulkan) return;
+    if (surface->damage)
+    {
+        if (!InterlockedCompareExchange( &surface->damage_invalid, 0, 0 )) return;
+        client_surface_damage_stop( surface );
+    }
+    pthread_once( &damage_once, client_surface_damage_init );
+    if (!damage_enabled) return;
+    /* The drawable is created/reparented on a different connection. Finish
+     * those requests before subscribing on its owner's event connection. */
+    XSync( gdi_display, False );
+    if (!(data = get_win_data( hwnd ))) return;
+    /* Subscribe on the window owner's event connection, not gdi_display: its
+     * normal message loop must wake even when the rendering thread goes idle. */
+    X11DRV_expect_error( data->display, damage_create_error, NULL );
+    surface->damage = pXDamageCreate( data->display, surface->window, XDamageReportNonEmpty );
+    XSync( data->display, False );
+    if (X11DRV_check_error())
+    {
+        WARN_(fusion)( "drawable %#lx disappeared before Damage subscription\n", surface->window );
+        surface->damage = None;
+    }
+    else if (surface->damage)
+    {
+        int missing;
+        XLockDisplay( data->display );
+        missing = XSaveContext( data->display, surface->damage, damage_context, (char *)&surface->client );
+        if (!missing) surface->damage_display = data->display;
+        XUnlockDisplay( data->display );
+        if (missing)
+        {
+            pXDamageDestroy( data->display, surface->damage );
+            XFlush( data->display );
+            surface->damage = None;
+        }
+    }
+    release_win_data( data );
+    if (surface->damage)
+        TRACE_(fusion)( "watching offscreen Vulkan drawable %#lx, damage %#lx\n", surface->window, surface->damage );
+}
+#else
+BOOL client_surface_damage_error( Display *display, XErrorEvent *event ) { return FALSE; }
+static void client_surface_damage_stop( struct x11drv_client_surface *surface ) {}
+static void client_surface_damage_start( HWND hwnd, struct x11drv_client_surface *surface ) {}
+#endif
