@@ -444,6 +605,7 @@ static void client_surface_update_offscreen( HWND hwnd, struct x11drv_client_sur
 #ifdef SONAME_LIBXCOMPOSITE
         if (usexcomposite) pXCompositeRedirectWindow( gdi_display, surface->window, CompositeRedirectManual );
 #endif
+        client_surface_damage_start( hwnd, surface );
