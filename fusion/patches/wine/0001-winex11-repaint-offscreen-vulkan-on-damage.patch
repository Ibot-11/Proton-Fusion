-void client_surface_present( struct client_surface *surface )
+static void client_surface_present_locked( struct client_surface *surface )
 {
     HDC hdc = 0;
     HWND hwnd;
 
-    pthread_mutex_lock( &surfaces_lock );
     if ((hwnd = surface->hwnd))
     {
         if (surface->offscreen) hdc = NtUserGetDCEx( hwnd, 0, DCX_CACHE | DCX_USESTYLE );
         surface->funcs->present( surface, hdc );
         if (hdc) NtUserReleaseDC( hwnd, hdc );
     }
+}
+
+void client_surface_present( struct client_surface *surface )
+{
+    pthread_mutex_lock( &surfaces_lock );
+    client_surface_present_locked( surface );
+    pthread_mutex_unlock( &surfaces_lock );
+}
+
+/* Native display notifications can outlive a swapchain or its window. Compare
+ * the identity with the live list under the same lock used by detach/release;
+ * never dereference the pointer supplied by the event queue itself. */
+void client_surface_present_external( const void *identity )
+{
+    struct client_surface *surface;
+
+    pthread_mutex_lock( &surfaces_lock );
+    LIST_FOR_EACH_ENTRY( surface, &client_surfaces, struct client_surface, entry )
+    {
+        if (surface != identity) continue;
+        if (surface->offscreen) client_surface_present_locked( surface );
+        break;
+    }
     pthread_mutex_unlock( &surfaces_lock );
 }
 
