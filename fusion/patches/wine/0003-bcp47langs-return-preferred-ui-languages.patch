diff --git a/dlls/bcp47langs/main.c b/dlls/bcp47langs/main.c
index ab0a0b5..344597c 100644
--- a/dlls/bcp47langs/main.c
+++ b/dlls/bcp47langs/main.c
@@ -59,6 +59,30 @@ HRESULT WINAPI GetFontFallbackLanguageList(const WCHAR *lang, size_t buffer_leng
 
 HRESULT WINAPI GetUserLanguages(WCHAR delim, HSTRING *langs)
 {
-    FIXME("%lc, %p\n", delim, langs);
-    return S_OK;
+    ULONG count, size = 0;
+    WCHAR *buffer, *src, *dst;
+    HRESULT hr;
+
+    TRACE("%lc, %p\n", delim, langs);
+    if (!langs) return E_INVALIDARG;
+    *langs = NULL;
+    if (!GetUserPreferredUILanguages(MUI_LANGUAGE_NAME, &count, NULL, &size))
+        return HRESULT_FROM_WIN32(GetLastError());
+    if (!(buffer = HeapAlloc(GetProcessHeap(), 0, size * sizeof(*buffer)))) return E_OUTOFMEMORY;
+    if (!GetUserPreferredUILanguages(MUI_LANGUAGE_NAME, &count, buffer, &size))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        HeapFree(GetProcessHeap(), 0, buffer);
+        return hr;
+    }
+
+    /* Convert the ordered MULTI_SZ into the caller's delimited HSTRING. */
+    for (src = dst = buffer; *src;)
+    {
+        while (*src) *dst++ = *src++;
+        if (*++src) *dst++ = delim;
+    }
+    hr = WindowsCreateString(buffer, dst - buffer, langs);
+    HeapFree(GetProcessHeap(), 0, buffer);
+    return hr;
 }
