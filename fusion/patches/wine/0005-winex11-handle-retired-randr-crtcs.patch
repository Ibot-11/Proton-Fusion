diff --git a/dlls/winex11.drv/xrandr.c b/dlls/winex11.drv/xrandr.c
--- a/dlls/winex11.drv/xrandr.c
+++ b/dlls/winex11.drv/xrandr.c
@@ -86,6 +86,34 @@
 
 #undef MAKE_FUNCPTR
 
+#ifdef HAVE_XRRGETPROVIDERRESOURCES
+static int xrandr_opcode, xrandr_error_base;
+
+static int crtc_query_error( Display *display, XErrorEvent *event, void *arg )
+{
+    return event->request_code == xrandr_opcode && event->minor_code == X_RRGetCrtcInfo &&
+           event->error_code == xrandr_error_base + BadRRCrtc;
+}
+
+static XRRCrtcInfo *get_crtc_info( Display *display, XRRScreenResources *resources, RRCrtc crtc )
+{
+    XRRCrtcInfo *info;
+
+    /* Screen-resource snapshots may outlive a connector/CRTC during DPMS,
+     * unlock or hotplug. The existing callers already handle a missing reply.
+     * XRRGetCrtcInfo waits for its reply, so no extra XSync is necessary. */
+    X11DRV_expect_error( display, crtc_query_error, NULL );
+    info = pXRRGetCrtcInfo( display, resources, crtc );
+    if (X11DRV_check_error())
+    {
+        WARN( "CRTC %#lx disappeared during display query\n", crtc );
+        if (info) pXRRFreeCrtcInfo( info );
+        info = NULL;
+    }
+    return info;
+}
+#endif
+
 static int load_xrandr(void)
 {
     int r = 0;
