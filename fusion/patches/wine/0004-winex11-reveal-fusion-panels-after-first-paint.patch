+/* Qt shows new command panels before moving and painting them. Keep their
+ * initial X11 backing store transparent until GDI has supplied real pixels.
+ * Only arm this for actual buffered GDI surfaces, never GPU or layered windows. */
+BOOL fusion_prepare_first_paint( struct x11drv_win_data *data )
+{
+    const char *setting = getenv( "WINE_FUSION_PANEL_FIRST_PAINT" );
+    DWORD style = NtUserGetWindowLongW( data->hwnd, GWL_STYLE );
+    DWORD ex_style = NtUserGetWindowLongW( data->hwnd, GWL_EXSTYLE );
+    UINT dpi = NtUserGetDpiForWindow( data->hwnd );
+
+    if (data->fusion_first_paint) return data->fusion_first_paint == 1;
+    if (!setting || !strcmp( setting, "0" ) || !data->whole_window || data->embedded ||
+        !(style & WS_POPUP) || !(ex_style & WS_EX_TOOLWINDOW) || (ex_style & WS_EX_LAYERED) ||
+        !NtUserGetWindowRelative( data->hwnd, GW_OWNER ) || !fusion_qt_tool( data->hwnd )) return FALSE;
+    if (!dpi) dpi = 96;
+    if (data->rects.window.right - data->rects.window.left < (180 * dpi + 48) / 96 ||
+        data->rects.window.bottom - data->rects.window.top < (100 * dpi + 48) / 96) return FALSE;
+
+    data->fusion_first_paint = 1;
+    sync_window_opacity( data->display, data->whole_window, 0, LWA_ALPHA );
+    XFlush( data->display ); /* opacity precedes mapping on this same connection */
+    return TRUE;
+}
+
+void fusion_finish_first_paint( struct x11drv_win_data *data )
+{
+    COLORREF key;
+    BYTE alpha = 255;
+    DWORD flags;
+
+    if (data->fusion_first_paint != 1) return;
+    if (!NtUserGetLayeredWindowAttributes( data->hwnd, &key, &alpha, &flags )) flags = 0;
+    data->fusion_first_paint = 2;
+    sync_window_opacity( data->display, data->whole_window, alpha, flags );
+    XFlush( data->display );
+}
+
 
